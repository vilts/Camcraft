; HSMW-CNC v1
PARAM StartX 12.000000
PARAM StartY 0.000000
PARAM StartZ 16.000000
PARAM OperationName Face one
PARAM ToolDiameter 0.000000
PARAM SpindleSpeed 1200.000000
PARAM WorkOffset G54
PARAM OriginX 0.000000
PARAM OriginY 0.000000
PARAM OriginZ 0.000000
PARAM ClearancePlane 50.000000
PARAM RetractPlane 5.000000
PARAM TopOfStock 0.000000
PARAM StockXYLeft -50.000000
PARAM StockXYRight 50.000000
PARAM StockXYFront -50.000000
PARAM StockXYBack 50.000000
PARAM StockZTop 0.000000
TOOL 1 FACE-12
SECTION
Rapid X 12000 Y 0 Z 15000
Feed X 0 Y 0 Z 15000 F 150000
Rapid X 12000 Y 0 Z 16000
ENDSECTION
PARAM StartX 12.000000
