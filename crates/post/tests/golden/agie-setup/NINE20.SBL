sub SetOrigin
  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_HEIGHT,"20.000",je_dim)
  ok=JE_AttribObject(PIECE,SETATTR,je_piece,NULL,NULL,NULL,ID_NOMEOBJ,"NINE20",je_dim)
