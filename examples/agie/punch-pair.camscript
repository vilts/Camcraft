// Original CAMCraft example. Run from the project root with a fresh output name.
cam.call("load_machine", {builtin: "AGIECUT Classic 2S (template)"});
// This synthetic job explicitly selects the resident recipe and its preview gap.
cam.call("edit_machine", {patch: {edm: {conditions: [{
  id: "AGIE_QN2", role: "rough", gap: 0.005, wire_diameter: 0.25
}]}}});
cam.call("add_tool", {catalog: "EDM-W025"});
cam.import("examples/agie/pair-left.obj", "left");
cam.import("examples/agie/pair-right.obj", "right");
cam.call("set_stock", {box: {dx: 80, dy: 60, dz: 20}});
cam.call("set_wcs", {origin: [0, 0, 20]});
cam.call("add_operation", {
  kind: "Wire Contour", name: "Punch1", source: "left", tool: "EDM-W025",
  params: {
    top_z: 20, bottom_z: 0, side: "punch", condition: "AGIE_QN2",
    start: [-30, 0], capture: true
  }
});
cam.call("add_operation", {
  kind: "Wire Contour", name: "Punch2", source: "right", tool: "EDM-W025",
  params: {
    top_z: 20, bottom_z: 0, side: "punch", condition: "AGIE_QN2",
    start: [1, 0], capture: true
  }
});
cam.generate();
cam.post({to: "PAIR20", cps: "Native wire EDM job files", options: {separationLengthMm: 1.0}});
