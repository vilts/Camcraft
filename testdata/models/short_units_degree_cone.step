#27 = DRCTN('', (0.0, 0.0, -1.0));
#28 = DRCTN('', (1.0, 0.0, 0.0));
#30 = ADVANCED_FACE('', (#31), #34, .T.);
#31 = FACE_OUTER_BOUND('', #32, .T.);
